{
  "description": "Lembrete da rotina do agente no Valk Hub, no início da sessão, e o consumo de IA da sessão, no fim. Nenhum dos dois bloqueia nada.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/consumo-de-ia/enviar.mjs"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
