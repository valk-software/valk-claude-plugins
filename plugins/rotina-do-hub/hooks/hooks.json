{
  "description": "Lembrete da rotina do agente no Valk Hub, no início da sessão. Só adiciona contexto, não bloqueia nada.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
